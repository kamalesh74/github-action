name: Deploy devhub-home

on:
  workflow_dispatch:
    inputs:
      environment:
        type: environment
        description: Select the environment
        default: dev
        required: true
      release-build:
        type: boolean
        description: Whether this is a release build
        default: false

      check-for-sca-sast:
        type: boolean
        description: Scan code & dependencies for security issues
        default: false

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}-${{ github.event.inputs.environment || 'dev' }}
  cancel-in-progress: true

jobs:

  build:
    name: Building Steps
    runs-on: docker-maven-21-arc
    environment: ${{ github.event.inputs.environment || 'dev' }}
    env:
      RUN_ID: ${{ github.run_id }}
      APP_NAME: devhub-home
      NAMESPACE: devhub
      REGISTRY: 506887928038.dkr.ecr.us-east-2.amazonaws.com

    steps:
      - name: Checkout from Git
        uses: actions/checkout@v4.0.0
        with:
          fetch-depth: 0

      - name: Export Branch Name as Environment Variable
        uses: nelonoel/branch-name@v1.0.1

      - name: Set Environment Specific Variables
        id: sets-ingress-value
        env:
          ENVIRONMENT: ${{ github.event.inputs.environment }}
        run: |
          case $ENVIRONMENT in
          "prod")   echo "INGRESS=docs.worldpay.com" >> $GITHUB_ENV
                    echo "BUILD_COMMAND=build:prod" >> $GITHUB_ENV ;;
          "cert")   echo "INGRESS=staging-docs.worldpay.com" >> $GITHUB_ENV
                    echo "BUILD_COMMAND=build:cert" >> $GITHUB_ENV ;;
          "dev"|*)  echo "INGRESS=dev-docs.worldpay.com" >> $GITHUB_ENV
                    echo "BUILD_COMMAND=build:dev" >> $GITHUB_ENV ;;
          esac

      - name: Determine Image Tag
        id: sets-image-tag
        env:
          RELEASE_BUILD: ${{ github.event.inputs.release-build }}
        run: |
          if [[ $RELEASE_BUILD == true ]]; then
            echo "IMAGE_TAG=${{ env.REGISTRY }}/${{ env.NAMESPACE }}/${{ env.APP_NAME }}:${{ env.BRANCH_NAME }}-${{ env.RUN_ID }}" >> $GITHUB_ENV
          else
            echo "IMAGE_TAG=${{ env.REGISTRY }}/${{ env.NAMESPACE }}/${{ env.APP_NAME }}:devbuild-${{ env.BRANCH_NAME }}-${{ env.RUN_ID }}" >> $GITHUB_ENV
          fi

      - name: Setup Kubectl
        uses: Azure/setup-kubectl@v4.0.0
        with:
          version: 'v1.30.1'
        id: install

      - uses: wp-enterprise-api/actions-workflows/actions/kpack@master
        name: Build Image w/ kpack
        with:
          appName: ${{ env.APP_NAME }}
          imageName: ${{ env.REGISTRY }}/devhub/${{ env.APP_NAME }}
          additionalImageTag: ${{ env.IMAGE_TAG }}
          builder: jammy-base
          buildEnvVars: |
            {
              "BP_WEB_SERVER": "nginx",
              "BP_NODE_PROJECT_PATH": "/devhub-home",
              "BP_WEB_SERVER_ROOT": "dist",
              "BP_WEB_SERVER_ENABLE_PUSH_STATE": "true",
              "BP_WEB_SERVER_FORCE_HTTPS": "false",
              "BP_NODE_RUN_SCRIPTS": "${{ env.BUILD_COMMAND }}"
            }
        id: kpack

      - uses: wp-enterprise-api/actions-workflows/actions/snyk@master
        name: Snyk Scan
        if: ${{ inputs.check-for-sca-sast == true || github.ref_type == 'tag' }}
        with:
          application-name: ${{ env.APP_NAME }}
          multi-module: 'true'
          snyk-token: ${{ secrets.SNYK_TOKEN }}
          snyk-org-id: ${{ secrets.SNYK_ORG_ID }}

      - name: Set K8s Context
        uses: Azure/k8s-set-context@v4.0.1
        with:
          method: kubeconfig
          kubeconfig: ${{ secrets.KUBE_CONFIG }}
          context: eapi
          cluster-type: "generic"
        id: setcontext-deploy

      - name: Inject Ingress Host into K8s Manifest
        env:
          INGRESS_HOST: ${{ env.INGRESS }}
        run: |
          set -e
          envsubst < ${{ env.APP_NAME }}/k8s/resources.yml > tmp
          mv tmp ${{ env.APP_NAME }}/k8s/resources-out.yml

      - name: Deploy to Kubernetes
        uses: Azure/k8s-deploy@v5.0.0
        with:
          namespace: ${{ env.NAMESPACE }}
          manifests: ${{ env.APP_NAME }}/k8s/resources-out.yml
          images: ${{ env.IMAGE_TAG }}
          action: deploy
